# Template. Copy this file to .env and put your real token in it:
#     cp .env.example .env
# then edit .env. The .env file is gitignored and will never be committed.
# This .env.example is committed on purpose and must NOT contain a real token.

ENTSOE_TOKEN=your-token-here

# netztransparenz.de WebAPI (German reBAP imbalance price, R9). Register for the
# "WebAPIReader" role at https://extranet.netztransparenz.de, create a client in
# https://api-portal.netztransparenz.de/ to get these two values.
IPNT_CLIENT_ID=your-client-id-here
IPNT_CLIENT_SECRET=your-client-secret-here
